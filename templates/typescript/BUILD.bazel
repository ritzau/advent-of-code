"""Build targets for Advent of Code TypeScript solution."""

load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@npm_typescript_template//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

# Compile all TypeScript source files to JavaScript
ts_project(
    name = "typescript_sources",
    srcs = [
        "common.ts",
        "main.ts",
        "part1.ts",
        "part2.ts",
    ],
    declaration = True,
    resolve_json_module = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig.json",
    deps = [":node_modules/@types/node"],
)

# Compile test files
ts_project(
    name = "test_sources",
    srcs = ["common.test.ts"],
    declaration = True,
    resolve_json_module = True,
    transpiler = "tsc",
    tsconfig = ":tsconfig.json",
    deps = [
        ":node_modules/@types/node",
        ":typescript_sources",
    ],
)

# Test target using Node.js built-in test runner
js_test(
    name = "test",
    data = [
        ":test_sources",
        ":typescript_sources",
    ],
    entry_point = "common.test.js",
)

# Main verification binary - runs both parts and validates results
js_binary(
    name = "main",
    data = [":typescript_sources"],
    entry_point = "main.js",
    node_options = ["--enable-source-maps"],
)

# Part 1 binary - outputs only part 1 result
js_binary(
    name = "part1",
    data = [":typescript_sources"],
    entry_point = "part1.js",
    node_options = ["--enable-source-maps"],
)

# Part 2 binary - outputs only part 2 result
js_binary(
    name = "part2",
    data = [":typescript_sources"],
    entry_point = "part2.js",
    node_options = ["--enable-source-maps"],
)
